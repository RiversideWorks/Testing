<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Morrison — Creative Agency</title>
    <style>
        /* CSS Reset & Variables */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-color: #ffffff;
            --text-color: #111111;
            --muted-color: #666666;
            --border-color: #e5e5e5;
            --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-main);
            overflow-x: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Spotlight Canvas Layer */
        #spotlight-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 10;
        }

        /* Navigation Header */
        header {
            width: 100%;
            padding: 40px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 20;
        }

        .logo {
            font-size: 1.1rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--text-color);
        }

        .nav-links {
            display: flex;
            gap: 32px;
            list-style: none;
        }

        .nav-links a {
            font-size: 0.9rem;
            text-decoration: none;
            color: var(--muted-color);
            transition: color 0.2s ease;
        }

        .nav-links a:hover {
            color: var(--text-color);
        }

        /* Hero Section Main Content */
        .hero {
            position: relative;
            z-index: 20;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 60px;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            flex-grow: 1;
        }

        .hero-tag {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted-color);
            margin-bottom: 20px;
        }

        .hero-title {
            font-size: clamp(3.5rem, 8vw, 7.5rem);
            font-weight: 400;
            line-height: 1.05;
            letter-spacing: -0.03em;
            margin-bottom: 30px;
        }

        .hero-description {
            font-size: 1.15rem;
            color: var(--muted-color);
            max-width: 480px;
            line-height: 1.5;
            letter-spacing: -0.01em;
        }

        /* Footer Info */
        footer {
            width: 100%;
            padding: 40px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid var(--border-color);
            z-index: 20;
            font-size: 0.85rem;
            color: var(--muted-color);
        }

        .location {
            letter-spacing: -0.01em;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            header, .hero, footer {
                padding-left: 24px;
                padding-right: 24px;
            }
            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Interactive Spotlight Canvas Layer -->
    <canvas id="spotlight-canvas"></canvas>

    <!-- Header -->
    <header>
        <a href="#" class="logo">Morrison</a>
        <ul class="nav-links">
            <li><a href="#work">Work</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#studio">Studio</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </header>

    <!-- Hero Section -->
    <main class="hero">
        <p class="hero-tag">London Creative Agency</p>
        <h1 class="hero-title">Hand-crafted</h1>
        <p class="hero-description">Bridging high-end digital development, brand identity, and visual storytelling with absolute clarity.</p>
    </main>

    <!-- Footer -->
    <footer>
        <span class="location">London, UK</span>
        <span>© 2026 Morrison</span>
    </footer>

    <!-- JavaScript for the Context-Aware Magnetic Spotlight -->
    <script>
        const canvas = document.getElementById('spotlight-canvas');
        const ctx = canvas.getContext('2d');

        let width, height;
        let mouse = { x: -500, y: -500, targetX: -500, targetY: -500 };
        
        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resize);
        resize();

        window.addEventListener('mousemove', (e) => {
            mouse.targetX = e.clientX;
            mouse.targetY = e.clientY;
        });

        // Smooth easing for the cursor spotlight
        function lerp(start, end, factor) {
            return start + (end - start) * factor;
        }

        // Draw the hidden geometric abstract graphic in the background when illuminated
        function drawHiddenGraphic(x, y) {
            ctx.save();
            ctx.translate(width * 0.75, height * 0.5); // Position of the hidden graphic on the right side
            
            ctx.strokeStyle = 'rgba(17, 17, 17, 0.12)';
            ctx.lineWidth = 1.5;

            // Abstract Minimalist Geometric Shape / Monogram Constellation
            ctx.beginPath();
            ctx.moveTo(-80, -80);
            ctx.lineTo(80, -80);
            ctx.lineTo(80, 80);
            ctx.lineTo(-80, 80);
            ctx.closePath();
            
            ctx.moveTo(-80, 0);
            ctx.lineTo(80, 0);
            
            ctx.moveTo(0, -80);
            ctx.lineTo(0, 80);

            // Inner geometric circle
            ctx.arc(0, 0, 45, 0, Math.PI * 2);
            ctx.stroke();

            ctx.restore();
        }

        function animate() {
            mouse.x = lerp(mouse.x, mouse.targetX, 0.15);
            mouse.y = lerp(mouse.y, mouse.targetY, 0.15);

            ctx.clearRect(0, 0, width, height);

            // 1. Draw the hidden graphic underneath
            drawHiddenGraphic();

            // 2. Create the Spotlight Overlay mask (Inverted radial gradient)
            // This leaves the rest of the canvas clean white, but illuminates an area around the mouse
            const gradientRadius = 220;
            const gradient = ctx.createRadialGradient(
                mouse.x, mouse.y, 10,
                mouse.x, mouse.y, gradientRadius
            );
            
            gradient.addColorStop(0, 'rgba(255, 255, 255, 0.98)');
            gradient.addColorStop(0.6, 'rgba(255, 255, 255, 0.85)');
            gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, width, height);

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>
